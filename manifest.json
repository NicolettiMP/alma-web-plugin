{
    "manifest_version": 3,
    "name": "Monitor de Tempo de Carregamento das Abas",
    "version": "1.0",
    "description": "Monitora o tempo de carregamento das abas no navegador.",
    "permissions": [
        "tabs",
        "webNavigation",
        "storage",
        "webRequest",
        "geolocation"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html"
    },
    "host_permissions": [
      "<all_urls>"
    ]
  }
  